{
    "name": "codexpert/wc-affiliate-email-tester",
    "version": "1.0.0",
    "description": "Developer tool to test, preview, and debug WC Affiliate email notifications.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Al Amin Ahamed",
            "email": "mrabir.ahamed@gmail.com",
            "homepage": "https://github.com/mralaminahamed",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6 || ^10.0",
        "yoast/phpunit-polyfills": "^1.1 || ^2.0",
        "brain/monkey": "^2.0",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "classmap": [
            "includes/"
        ]
    },
    "autoload-dev": {
        "classmap": [
            "tests/php/src/"
        ]
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-html coverage"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
