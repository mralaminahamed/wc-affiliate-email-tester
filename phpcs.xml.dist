<?xml version="1.0"?>
<ruleset name="WC Affiliate Email Tester">
    <description>Coding standards for WC Affiliate Email Tester.</description>

    <!-- Scan the plugin source. -->
    <file>./includes</file>
    <file>./templates</file>
    <file>./tests/php/src</file>
    <file>./wc-affiliate-email-tester.php</file>
    <file>./uninstall.php</file>

    <!-- Exclusions. -->
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/coverage/*</exclude-pattern>
    <exclude-pattern>*/assets/*</exclude-pattern>

    <!-- Arguments. -->
    <arg name="basepath" value="."/>
    <arg name="colors"/>
    <arg name="extensions" value="php"/>
    <arg value="sp"/>
    <arg name="parallel" value="4"/>

    <!-- Rules. -->
    <rule ref="WordPress">
        <!-- Allow short array syntax. -->
        <exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
        <!-- Yoda conditions are enforced — keep. -->
        <!-- Tests are not required to be hardened to the same level. -->
        <exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
        <exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
    </rule>

    <!-- PHP 8.0+ minimum. -->
    <config name="testVersion" value="8.0-"/>
    <config name="minimum_wp_version" value="6.5"/>

    <!-- Plugin text domain enforcement. -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="wc-affiliate-email-tester"/>
            </property>
        </properties>
    </rule>

    <!-- Test files: relax some rules. -->
    <rule ref="WordPress.NamingConventions.ValidVariableName">
        <exclude-pattern>./tests/*</exclude-pattern>
    </rule>
    <rule ref="WordPress.NamingConventions.ValidFunctionName">
        <exclude-pattern>./tests/*</exclude-pattern>
    </rule>
    <rule ref="WordPress.PHP.YodaConditions">
        <exclude-pattern>./tests/*</exclude-pattern>
    </rule>
</ruleset>
